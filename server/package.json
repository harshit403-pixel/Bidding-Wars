{
  "name": "Server",
  "version": "1.0.0",
  "description": "Production ready Express backend generated by create-backend-app",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --config ./jest.config.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --config ./jest.config.js",
    "test:legacy": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/__tests__",
    "test:private:auction": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/private/auction",
    "test:private:payment": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/private/payment",
    "test:private:dashboard": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/private/dashboard",
    "test:public:auction": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/public/auction",
    "test:public:auth": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/public/auth",
    "test:public:upload": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/public/upload",
    "test:private": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/private",
    "test:public": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules/public",
    "test:modules": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.js src/modules"
  },
  "dependencies": {
    "@jest/types": "^30.4.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-validator": "^7.2.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "^13.0.6",
    "test-exclude": "^7.0.1",
    "node-domexception": "npm:es-errors@^1.3.0"
  }
}
